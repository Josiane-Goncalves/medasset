datasource db {
  provider = "postgresql"
}

model Equipamento {
  id           String   @id @default(uuid()) @db.Uuid
  equipamento  String
  marca        String
  modelo       String
  numeroSerie  String   @unique
  patrimonio   String?  @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
